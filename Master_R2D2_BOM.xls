<?xml version="1.0" encoding="UTF-8"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:o="urn:schemas-microsoft-com:office:office"
 xmlns:x="urn:schemas-microsoft-com:office:excel"
 xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:html="http://www.w3.org/TR/REC-html40">
 <Styles>
  <Style ss:ID="Default" ss:Name="Normal">
   <Alignment ss:Vertical="Center"/>
   <Font ss:FontName="Calibri" ss:Size="11" ss:Color="#000000"/>
  </Style>
  <Style ss:ID="Header">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center" ss:WrapText="1"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
   </Borders>
   <Font ss:FontName="Calibri" ss:Size="11" ss:Color="#FFFFFF" ss:Bold="1"/>
   <Interior ss:Color="#1F4E78" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="Ordered">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
   </Borders>
   <Font ss:FontName="Calibri" ss:Size="11" ss:Color="#274E13" ss:Bold="1"/>
   <Interior ss:Color="#D9EAD3" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="Pending">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
   </Borders>
   <Font ss:FontName="Calibri" ss:Size="11" ss:Color="#7F6000" ss:Bold="1"/>
   <Interior ss:Color="#FFF2CC" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="Fabrication">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
   </Borders>
   <Font ss:FontName="Calibri" ss:Size="11" ss:Color="#1F4E78" ss:Bold="1"/>
   <Interior ss:Color="#CFE2F3" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="CellCenter">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
   </Borders>
  </Style>
  <Style ss:ID="CellText">
   <Alignment ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
   </Borders>
  </Style>
 </Styles>
 <Worksheet ss:Name="R2-D2 Master BOM">
  <Table ss:DefaultRowHeight="20">
   <Column ss:Width="50"/>
   <Column ss:Width="140"/>
   <Column ss:Width="200"/>
   <Column ss:Width="130"/>
   <Column ss:Width="50"/>
   <Column ss:Width="280"/>
   <Column ss:Width="340"/>
   <Row ss:Height="24">
    <Cell ss:StyleID="Header"><Data ss:Type="String">Item #</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Subsystem</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Component Name</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Status</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Qty</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Manufacturer / Specification</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Notes &amp; Wiring Reference</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">1</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Chassis &amp; Shell</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Base Shell &amp; Body</Data></Cell>
    <Cell ss:StyleID="Ordered"><Data ss:Type="String">Ordered / Acquired</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">1</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Home Depot Animated R2-D2 Body</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Base structural chassis with center post pivot frame</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">2</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Chassis &amp; Shell</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Dome Shell &amp; Pivot</Data></Cell>
    <Cell ss:StyleID="Ordered"><Data ss:Type="String">Ordered / Acquired</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">1</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Home Depot Animated R2-D2 Dome</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Rotating upper dome shell riding on center pivot post</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">3</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Foot Drive Subsystem</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Brushless Hub Motors</Data></Cell>
    <Cell ss:StyleID="Ordered"><Data ss:Type="String">Ordered / Acquired</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">2</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Razor Tekno Pop 100mm integrated brushless hub motors</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">12V known; exact power unconfirmed, roughly80-100W discussed (user estimates100W). Do not derive phase-current limits from wattage. 16mm x11mm Double-D axles.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">4</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Foot Drive Subsystem</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Dual Motor Controller</Data></Cell>
    <Cell ss:StyleID="Ordered"><Data ss:Type="String">Ordered / Acquired</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">1</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Flipsky Dual FSESC4.20 100A</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Each half is a separate VESC joined only by CAN. Solder a second receiver lead (signal + GND only) to the matching pads on the second half. CAN switch OFF. Each half: PPM app, timeout brake, safe start. Receiver CH1/CH2 (Elevon mix). See DRIVE_SETUP.md. One shared F1 15A supply.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">5</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Foot Drive Subsystem</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Axle Clamping Mounts</Data></Cell>
    <Cell ss:StyleID="Fabrication"><Data ss:Type="String">Fabrication (Ready)</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">2 pairs</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">3D Printed / Plywood 16x11mm Axle Clamps</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">STL models generated (Razor_Hub_Motor_Axle_Clamp_Top/Bottom.stl)</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">6</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Foot Drive Subsystem</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Hall Sensor Adapters</Data></Cell>
    <Cell ss:StyleID="Ordered"><Data ss:Type="String">Ordered / Acquired</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">2</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">6-Pin JST-ZH to 5-wire Hall Pigtails</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Connects Razor 5-wire Hall sensors to VESC ports</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">7</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Foot Drive Subsystem</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Motor Phase Connectors</Data></Cell>
    <Cell ss:StyleID="Ordered"><Data ss:Type="String">Ordered / Acquired</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">2 sets</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">3.5mm or 4.0mm Gold Bullet Connectors</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Connects 3-phase motor wires into VESC outputs</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">8</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Dome Drive Subsystem</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Dome Continuous Servo</Data></Cell>
    <Cell ss:StyleID="Ordered"><Data ss:Type="String">Ordered / Acquired</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">1</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">TIANKONGRC TD-8135MG-360 (35kg 360°)</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Body B-SERVO 5A fused 5V, 16AWG trunk. Signal from ESP32 GPIO4 via dome shifter ch2 and slip ring CH6. Trim neutral with transmitter CH4 subtrim.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">9</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Dome Drive Subsystem</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Dome Homing Sensors</Data></Cell>
    <Cell ss:StyleID="Ordered"><Data ss:Type="String">Ordered / Acquired (1 used)</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">2</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">KY-003 / 3144E Hall Effect Sensors</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">One sensor on the dome underside over the body magnet ring: dome D-LOGIC 5V, output via dome shifter ch3 to ESP32 GPIO5 (AUX3). Counts magnets to track the dome. Second sensor not used.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">10</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Dome Drive Subsystem</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Dome Magnet Ring</Data></Cell>
    <Cell ss:StyleID="Pending"><Data ss:Type="String">To order: 12 more (1 acquired)</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">13</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Neodymium disc magnets, 6x2mm or 10x2mm</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Glued on the body top surface on one circle, same face up: 12 every 30 degrees plus one 5 degrees clockwise of front. Print the template with tools/magnet_template.py. See DOME_SETUP.md section 5.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">11</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Dome Drive Subsystem</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Center Post Drive Coupler</Data></Cell>
    <Cell ss:StyleID="Ordered"><Data ss:Type="String">Ordered / Acquired</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">1</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">25T Servo Horn to Center Post Coupler</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Couples 35kg servo output directly to dome central pivot post</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">12</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Dome Brain &amp; Lights</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">AstroPixels Main Board (Brain)</Data></Cell>
    <Cell ss:StyleID="Ordered"><Data ss:Type="String">Ordered / Acquired</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">1</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">AstroPixels ESP32 30-Pin Module</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Stock AstroPixelsPlus + R2Remote (AstroPixelsPlus/ in repo): lights, holo servos, mood sounds/volume via DFPlayer, dome servo, reads receiver iBUS on GPIO16. D-LOGIC 3A supply.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">13</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Dome Brain &amp; Lights</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Logic Displays (FLD &amp; RLD)</Data></Cell>
    <Cell ss:StyleID="Ordered"><Data ss:Type="String">Ordered / Acquired</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">3</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">AstroPixels WS2812 FLD1/2 &amp; RLD</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Front &amp; Rear Logic displays (GPIO 15 &amp; 33)</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">14</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Dome Brain &amp; Lights</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Process State Indicators (PSIs)</Data></Cell>
    <Cell ss:StyleID="Ordered"><Data ss:Type="String">Ordered / Acquired</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">2</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">AstroPixels WS2812 FPSI &amp; RPSI</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Front &amp; Rear PSI displays (GPIO 32 &amp; 23)</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">15</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Dome Brain &amp; Lights</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">HoloProjector LED Boards</Data></Cell>
    <Cell ss:StyleID="Ordered"><Data ss:Type="String">Ordered / Acquired</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">3</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">AstroPixels WS2812 HP Light Rings</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Front, Rear, and Top Holo LED cores (GPIO 25, 26, 27)</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">16</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Dome Brain &amp; Lights</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Holo Micro Servos</Data></Cell>
    <Cell ss:StyleID="Ordered"><Data ss:Type="String">Ordered / Acquired</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">6</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">TowerPro MG90S Metal Gear Servos</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">2 servos per HP (Pan &amp; Tilt for 3 Holos) on PCA9685</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">17</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Dome Brain &amp; Lights</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">HP 2-Axis Gimbal Brackets</Data></Cell>
    <Cell ss:StyleID="Fabrication"><Data ss:Type="String">Fabrication (Ready)</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">3</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">3D-Printed Custom Pan/Tilt Mounts</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Gimbal brackets holding the 3 Holoprojector units</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">18</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Dome Brain &amp; Lights</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">I2C PWM Servo Driver</Data></Cell>
    <Cell ss:StyleID="Ordered"><Data ss:Type="String">Ordered / Acquired</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">1</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">PCA9685 16-Channel 12-bit PWM Module</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">VCC=ESP32 3.3V; SDA21/SCL22/GND from I2C D/C/G, headerV unused. V+ via D-SERVO5A,16AWG feed/return. 0x40,50Hz,channels0-5. Test each servo then all six; stop for heat/jams, do not enlarge fuse.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">19</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Dome Brain &amp; Lights</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Dome Buffer Capacitor</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Optional / Not required</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">1</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">1000uF - 2200uF 10V/16V Low-ESR Cap</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Diagnostic option for observed supply transients, not a mandatory purchase. Fix wiring/jams before adding capacitance.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">20</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Dome Brain &amp; Lights</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Dome 5V Distribution Block</Data></Cell>
    <Cell ss:StyleID="Ordered"><Data ss:Type="String">Ordered / Acquired</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">1</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">uxcell 6-Position Dual Row Terminal Block</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Owned dome block. Continuity-check isolated pairs; jumper intended5V/GND groups separately. D-SERVO5A and D-LOGIC3A inline branches; separate fused logic fan-out, no bypass jumper. No separate5V fuse box.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">21</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Slip Ring Interface</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Through-Bore Slip Ring</Data></Cell>
    <Cell ss:StyleID="Ordered"><Data ss:Type="String">Ordered / Acquired</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">1</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Senring H3086 (30mm ID, 6-Channel 10A)</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">17AWG leads, 10A/contact. CH1=F4 7.5A to dome buck; CH2=GND; CH3=receiver iBUS to dome shifter; CH4=ESP32 GPIO19 to DFPlayer RX (1k); CH5=DFPlayer TX to ESP32 GPIO18; CH6=dome servo signal. See WIRING.md.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">22</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Sound Subsystem (Body)</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Sound Engine Module</Data></Cell>
    <Cell ss:StyleID="Ordered"><Data ss:Type="String">Ordered / Acquired</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">1</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">DFPlayer Mini MP3 Player Board</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Body B-LOGIC 2A fused 5V. RX from ESP32 GPIO19 via 1k resistor (ring CH4); TX to ESP32 GPIO18 (ring CH5). SD card: /mp3/0001.mp3 ... (see AstroPixelsPlus/HDR2D2.md).</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">23</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Sound Subsystem (Body)</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Sound MicroSD Card</Data></Cell>
    <Cell ss:StyleID="Ordered"><Data ss:Type="String">Ordered / Acquired</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">1</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">16GB / 32GB MicroSD Card (FAT32)</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">FAT32, 32GB or less. Sounds in /mp3 named 0001.mp3, 0002.mp3 ... by bank: number = (bank - 1) x 25 + position. Start-up sound 0255.mp3. See SOUND_SETUP.md.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">24</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Sound Subsystem (Body)</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Audio Series Resistor</Data></Cell>
    <Cell ss:StyleID="Ordered"><Data ss:Type="String">Ordered / Acquired</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">1</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">1kΩ 1/4W Resistor</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">In the DFPlayer RX line from slip ring CH4 (ESP32 GPIO19). Not a voltage converter.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">25</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Sound Subsystem (Body)</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Audio Amplifier</Data></Cell>
    <Cell ss:StyleID="Ordered"><Data ss:Type="String">Ordered / Acquired</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">1</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">HF82 / TPA3110 stereo amp, Amazon.ca B09F2XR9MN; listed8-26V DC,4-10ohm,2x15W; solder-pad connections</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">F5 5A battery branch, 18AWG. DFPlayer DAC through BESIGN isolator to line input. Speaker negatives are not ground. Volume set by transmitter dial VrB (DFPlayer 0-30).</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">26</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Sound Subsystem (Body)</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Speaker</Data></Cell>
    <Cell ss:StyleID="Ordered"><Data ss:Type="String">Ordered / Acquired</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">1</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Nobsound 2.5-inch 8Ω 15W Full-Range</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Mounted behind front acoustic vents in body</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">27</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Sound Subsystem (Body)</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Audio Ground Loop Isolator</Data></Cell>
    <Cell ss:StyleID="Ordered"><Data ss:Type="String">Ordered / Acquired</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">1</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">BESIGN3.5mm ground-loop isolator; user-selected Amazon.ca B06XQYN77L, plus2stereo TRS-to-screw-terminal adapters with matching mating connectors</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">DFPlayer DAC_L/GND to source adapter tip/sleeve; isolator to amplifier adapter tip/sleeve to LINE L/GND. Ring/R unused; no external sleeve bridge. Passive, no power. Not B0505S; not SPK outputs. Speaker across ampL+/L-, neither to ground.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">28</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Sound Subsystem (Body)</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Audio Volume Potentiometer</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Unused / Not required</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">1</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">10kΩ Logarithmic Stereo Potentiometer</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Not needed: volume is the transmitter VrB dial.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">29</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Power &amp; Safety</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">10A 5V Buck Converter</Data></Cell>
    <Cell ss:StyleID="Ordered"><Data ss:Type="String">Ordered / Acquired</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">1</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Amazon B09T954ZV1: listed10-35V input, fixed5V/10A output,50W, non-isolated</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Existing unit in dome, F4 7.5A before ring,16AWG input extensions,12AWG output trunk extensions. Measure fixed output/polarity; verify factory leads. No5.05V adjustment.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">30</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Power &amp; Safety</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Main Battery Pack</Data></Cell>
    <Cell ss:StyleID="Ordered"><Data ss:Type="String">Ordered / Acquired</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">1</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Renogy Core 12V 20Ah LiFePO4 (RBT1220LFP-TM)</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">20A Continuous / 75A 5s Surge Peak; Grade-A IP65 pack (5.95 lbs)</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">31</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Power &amp; Safety</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Main Battery Charger</Data></Cell>
    <Cell ss:StyleID="Ordered"><Data ss:Type="String">Ordered / Acquired</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">1</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Purchased ECO-WORTHY nominal10A charger, Amazon.ca B09SYNQNC1; listing LiFePO4 output14.4V9A</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Use LiFePO4 mode and supplied SAE ring lead with10A fuse; verify actual label/polarity on arrival. MasterOFF while charging, unplug before drive; no charging below0C. BMS activation is not routine charging.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">32</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Power &amp; Safety</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Main DC Fuse &amp; Holder</Data></Cell>
    <Cell ss:StyleID="Ordered"><Data ss:Type="String">Ordered / Acquired</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">1</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">25A fuse, matched holder rated at least32V DC/30A with10AWG pigtails or suitable studs</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Battery+ to fuse before cutoff; target at most150mm unfused cable. Protects10AWG harness, does NOT enforce20A battery continuous limit; verify fuse inrush/temperature behavior.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">33</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Power &amp; Safety</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Tier 1 Master Cutoff Switch</Data></Cell>
    <Cell ss:StyleID="Ordered"><Data ss:Type="String">Ordered / Acquired</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">1</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Documented DC load-break battery disconnect rated at least30A at16V, covered terminals; higher rating acceptable</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">After main fuse, before all operating branches; immediately accessible at body hatch/exterior, no reach past wheels. Not anAC-only toggle; charge lead remains live.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">34</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Power &amp; Safety</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Dome 12V Branch Fuse &amp; Holder</Data></Cell>
    <Cell ss:StyleID="Ordered"><Data ss:Type="String">Ordered / Acquired</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">1</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">7.5A DC branch fuse, installed as F4 in covered12V fuse block (item44)</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Before ringCH1,16AWG extensions/17AWG factory leads. No separate duplicate inline holder if F4 provides source protection. Do not fuse ground; verify factory-lead compatibility.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">35</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Power &amp; Safety</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Battery Voltage Telemetry Sensor</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Optional</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">1</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">FS-CVT01 sensor; user-selected Amazon.ca B0DQXT337L; no standalone display</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Optional: plugs into receiver SENS port to show pack voltage on the FS-i6X screen. No code involved.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">36</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Radio Control</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">2.4GHz RC Transmitter</Data></Cell>
    <Cell ss:StyleID="Ordered"><Data ss:Type="String">Ordered / Acquired</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">1</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">FlySky FS-i6X 10-Channel 2.4GHz AFHDS 2A</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Right stick drive via Elevon mix on CH1/CH2. CH4 dome, CH5 SwA random dome, CH6 SwB play sound, CH7 VrA mood, CH8 VrB volume, CH9 SwC random sounds/holos, CH10 spare. Failsafe: CH1/2/4 centre, CH5 up. See TRANSMITTER_SETUP.md.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">37</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Radio Control</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">iBus Digital Receiver</Data></Cell>
    <Cell ss:StyleID="Ordered"><Data ss:Type="String">Ordered / Acquired</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">1</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">FlySky FS-iA6B 6/10-Ch iBus Receiver</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Body B-LOGIC 5V. Output mode PWM + i-BUS. CH1/CH2 PWM to the two VESC receiver leads (signal+GND). i-BUS SERVO port to slip ring CH3. SENS optional FS-CVT01.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">38</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Wiring &amp; Hardware</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Power Connectors &amp; Wire</Data></Cell>
    <Cell ss:StyleID="Ordered"><Data ss:Type="String">Ordered / Acquired</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">1 pack</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Stranded copper 10/12/16/18/20/22AWG; ring lugs matching studs, insulated crimp splices, and ferrules</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Follows the wire schedule in POWER.md: 12AWG for motor phases (6x 2m) and VESC power; 22AWG 5-core for motor Halls.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">39</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Wiring &amp; Hardware</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Signal Leads &amp; Connectors</Data></Cell>
    <Cell ss:StyleID="Ordered"><Data ss:Type="String">Ordered / Acquired</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">6 pcs</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Female servo leads (26AWG) and receiver/servo connectors</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">One female servo lead soldered to the VESC half-B receiver pads (signal + GND). Both VESC receiver leads: 5V pin removed. Keep PCA servo factory plugs. Short 22AWG signal leads with strain relief.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">40</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Wiring &amp; Hardware</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Mounting Standoffs Kit</Data></Cell>
    <Cell ss:StyleID="Ordered"><Data ss:Type="String">Ordered / Acquired</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">1 kit</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">M2.5 &amp; M3 Nylon / Brass Standoffs &amp; Screws</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Mounts VESC, Buck, Amp, PCA9685, and DFPlayer</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">41</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Wiring &amp; Hardware</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Programming Cable</Data></Cell>
    <Cell ss:StyleID="Ordered"><Data ss:Type="String">Ordered / Acquired</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">1 set</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Data Micro-USB cable for VESC Tool; data cable matching the ESP32 socket</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">VESC Tool over each half's USB port. ESP32 flashed with the module removed from the AstroPixels board.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">42</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Power &amp; Safety</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Body 10A 5V Buck Converter</Data></Cell>
    <Cell ss:StyleID="Ordered"><Data ss:Type="String">Ordered / Acquired</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">1</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Second matching B09T954ZV1-equivalent 10-35V input / fixed 5V 10A converter</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">F3 7.5A input; B-SERVO 5A and B-LOGIC 2A output branches. Powers receiver, DFPlayer and dome servo. Body/dome 5V positives separate.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">43</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Dome Brain &amp; I/O</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Old 3.3V / 5V Logic-Level Shifter</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Being returned / Not used</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">1</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Old module listing max28,800bps; unsuitable for115200 iBUS</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Superseded by selected Lonely Binary kit item50. Do not install old modules.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">44</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Power &amp; Safety</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Covered 12V Fuse Box with Integrated Negative Bus</Data></Cell>
    <Cell ss:StyleID="Ordered"><Data ss:Type="String">Ordered / Acquired</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">1 set</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">6-way blade fuse block with + and - feed studs and common negative bus</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Main25A and cutoff. F1VESC15A,F2empty,F3body7.5A,F4dome7.5A,F5amp5A,F6empty. One12V fuse block; no separate5V fuse boxes.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">45</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Power &amp; Safety</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Body 5V Screw-Terminal Distribution</Data></Cell>
    <Cell ss:StyleID="Ordered"><Data ss:Type="String">Owned</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">1 assembly</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Owned screw-terminal distribution, separate from dome item20</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Continuity-check terminal pairs, correctly sized jumpers for5V/GND. B-SERVO5A and B-LOGIC2A inline branches; insulated fused electronics fan-out. No output bypass jumper.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">46</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Wiring &amp; Hardware</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Harness Strain Relief &amp; Labels</Data></Cell>
    <Cell ss:StyleID="Ordered"><Data ss:Type="String">Ordered / Acquired</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">1 kit</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Grommets, abrasion split-loom, screw-mounted clamps, adhesive heatshrink, and wire labels</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Protects wiring through shell holes; provides service loops at shoulder pivots and secures connectors.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">47</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Power &amp; Safety</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Measurement Tools</Data></Cell>
    <Cell ss:StyleID="Pending"><Data ss:Type="String">Verify availability</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">1 set</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Digital multimeter and DC-capable clamp meter or inline wattmeter</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Multimeter for continuity, voltage and the half-B pad checks. DC-capable clamp meter or inline wattmeter for the 20A budget; never put a multimeter in current mode across the battery.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">48</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Body Controller</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Teensy 4.1</Data></Cell>
    <Cell ss:StyleID="Ordered"><Data ss:Type="String">Not used</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">1</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">PJRC Teensy4.1,3.3V I/O; matching male headers if not preinstalled</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Not used in the simplified droid (drive and dome come from the receiver and ESP32).</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">49</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Body Controller</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Treedix Teensy Carrier</Data></Cell>
    <Cell ss:StyleID="Ordered"><Data ss:Type="String">Not used</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">1</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Socketed screw-terminal carrier, Amazon.ca B09NXYWYK7</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Not used in the simplified droid.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">50</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Body / Dome I/O</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Lonely Binary Logic-Level Converter Kit</Data></Cell>
    <Cell ss:StyleID="Ordered"><Data ss:Type="String">Selected / Acquired (1 board used)</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">1 kit; use2 four-channel boards</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Amazon.ca B0FFMLDYNY,27-piece MOSFET kit,10k pull-ups</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Dome board only: ch1 iBUS in (ring CH3 -&gt; GPIO16), ch2 dome servo out (GPIO4 -&gt; ring CH6), ch3 front Hall (-&gt; GPIO5), ch4 spare. LV = ESP32 3.3V, HV = dome D-LOGIC 5V.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">51</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Power &amp; Safety</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Four 5V Inline Fuse Holders</Data></Cell>
    <Cell ss:StyleID="Ordered"><Data ss:Type="String">Owned</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">4</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Amazon.ca B0FDJYRGB7,12AWG leads,standard ATO/ATC blade</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Approved B-SERVO=5A,B-LOGIC=2A,D-SERVO=5A,D-LOGIC=3A. Fuse positive at takeoff before smaller branch leads; unfused grounds. Four holders only, no5V fuse boxes.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">52</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Power &amp; Safety</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">5V Branch Blade Fuses</Data></Cell>
    <Cell ss:StyleID="Ordered"><Data ss:Type="String">Ordered / Acquired</Data></Cell>
    <Cell ss:StyleID="CellCenter"><Data ss:Type="String">2x5A,1x2A,1x3A plus spares</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Standard automotive ATO/ATC matching item51; not mini-blade</Data></Cell>
    <Cell ss:StyleID="CellText"><Data ss:Type="String">Indexed included assortment starts5A. Buy matching2A and3A separately. Do not increase approved ratings after a blown fuse; diagnose fault.</Data></Cell>
   </Row>
  </Table>
 </Worksheet>
